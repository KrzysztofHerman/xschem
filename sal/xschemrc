# Source the PDK xschemrc file
if {![info exists PDK]} {
    source $env(PDK_ROOT)/$env(PDK)/libs.tech/xschem/xschemrc
}

# Add current directory
append XSCHEM_LIBRARY_PATH :[file dirname [info script]]

# Include the repository's standard device symbols when running from this
# checkout; these symbols carry the ports and labels needed for connectivity.
set xschem_repo_root [file normalize [file join [file dirname [info script]] ..]]
set XSCHEM_LIBRARY_PATH "[file join $xschem_repo_root xschem_library devices]:$xschem_repo_root:$XSCHEM_LIBRARY_PATH"

